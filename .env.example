# Local development settings. Never commit real secrets.
DATABASE_URL="postgresql://sahayak@localhost:54329/sahayak"

# 32-byte hex keys for local dev only. Generate new ones for any shared environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-to-a-random-64-char-hex-string"
DOCUMENT_ENC_KEY="change-me-to-64-hex-chars"

APP_URL="http://localhost:3000"

# OTP: "dev" shows the code on screen in development (never logged). Swap for a real SMS adapter in production.
OTP_PROVIDER="dev"

# Google Identity Services. Leave empty to use the dev-only mock Google sign-in.
GOOGLE_CLIENT_ID=""

# LLM for chatbot explanations (eligibility itself is deterministic). Leave empty for retrieval-only answers.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Email: leave SMTP_URL empty to deliver into the dev mailbox at /dev/mailbox
SMTP_URL=""
MAIL_FROM="SevaSutra <your-gmail@gmail.com>"

# Test admin phone number for local seed data (a test value, not a real person)
SEED_ADMIN_PHONE="+919999900001"
SEED_SUPPORT_PHONE="+919999900002"

# Email OTP sign-in (delivered through SMTP). true = email-verified users get applicant access (deviation from the brief, which asks for phone OTP).
EMAIL_OTP_GRANTS_APPLICANT="true"
